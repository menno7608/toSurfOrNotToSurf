# OpenWeatherMap One Call 3.0
OWM_API_KEY=your_openweather_key_here

# Pushbullet (voor kite_alert.py)
PUSHBULLET_TOKEN=your_pushbullet_token_here

# MET Norway (wereldwijde fallback als Open-Meteo eruit ligt)
# Hun voorwaarden eisen een echt contactadres in de User-Agent; zonder dit
# antwoordt de API met 403 en blijft de fallback stil onbruikbaar.
MET_CONTACT=jouw@email.nl
