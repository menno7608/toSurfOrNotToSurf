<?xml version="1.0" encoding="utf-8"?>
<!-- Vier lagen met oplopende dekking: de rand vloeit uit naar transparant, zodat
     de widget op het beginscherm zweeft in plaats van als een kaart te staan. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_a1" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_a2" />
            <corners android:radius="25dp" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_a3" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="9dp" android:top="9dp" android:right="9dp" android:bottom="9dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_a4" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>
