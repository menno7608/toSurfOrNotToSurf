[Unit]
Description=Weather Dashboard
After=network-online.target
Wants=network-online.target

[Service]
User={{USER}}
WorkingDirectory={{PROJECT}}/backend
Environment="PATH={{PROJECT}}/backend/.venv/bin"
ExecStart={{PROJECT}}/backend/.venv/bin/gunicorn \
    --workers 2 \
    --bind 0.0.0.0:5000 \
    --timeout 60 \
    app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
